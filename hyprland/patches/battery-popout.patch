+        running: false
+        stderr: StdioCollector {
+            onStreamFinished: chargeActionProcess.errorText = text.trim()
+        }
+        onExited: exitCode => {
+            if (exitCode === 0) {
+                if (restoreConfiguredThresholds)
+                    ToastService.showInfo(I18n.tr("Charge limit restored"), I18n.tr("TLP restored the configured charge thresholds."));
+                else
+                    ToastService.showInfo(I18n.tr("Full charge enabled"), I18n.tr("TLP will restore the configured thresholds at boot."));
+            } else {
+                const details = errorText || I18n.tr("Process exited with code %1").arg(exitCode);
+                ToastService.showError(I18n.tr("Failed to update charge thresholds"), details);
+            }
+            chargeRefreshTimer.restart();
+        }
+    }
+
+    Timer {
