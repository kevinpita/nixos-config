+/**
+ * Where a fork taken mid-turn ends: the last finished answer on `branch`, plus
+ * what follows it outside any turn (a compaction, a model change). Undefined
+ * while the first response is still running.
+ */
+function lastFinishedAnswerId(branch: readonly SessionEntry[]): string | undefined {
+	let index = branch.findLastIndex(entry => entry.type === "message" && isTerminalTextAssistantAnswer(entry.message));
+	if (index < 0) return undefined;
+	while (index + 1 < branch.length) {
+		const next = branch[index + 1]!.type;
+		if (next === "message" || next === "custom_message") break;
+		index++;
+	}
+	return branch[index]!.id;
+}
