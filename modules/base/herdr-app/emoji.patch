+/// For emoji cells: the emoji font before the system fallbacks, where
+/// DejaVu Sans draws some emoji in black and white.
+fn emoji_font(bold: bool, italic: bool) -> Font {
+    let mut f = cell_font(bold, italic);
+    f.fallbacks = Some(FontFallbacks::from_fonts(vec!["Noto Color Emoji".into()]));
+    f
+}
