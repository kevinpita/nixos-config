+    /// The first installed color emoji family that has `ch`.
+    fn color_emoji_family(&mut self, ch: char) -> Option<SharedString> {
+        if let Some(family) = self.color_emoji_families.get(&ch) {
+            return family.clone();
+        }
+        let db = self.font_system.db();
+        let family = db
+            .faces()
+            // The same name test as cosmic-text's own emoji detection.
+            .filter(|face| face.post_script_name.contains("Emoji"))
+            .find(|face| {
+                db.with_face_data(face.id, |data, index| {
+                    ttf_parser::Face::parse(data, index).is_ok_and(|font| {
+                        let tables = font.tables();
+                        let color = tables.colr.is_some()
+                            || tables.cbdt.is_some()
+                            || tables.sbix.is_some()
+                            || tables.svg.is_some();
+                        color && font.glyph_index(ch).is_some()
+                    })
+                })
+                .unwrap_or(false)
+            })
+            .and_then(|face| face.families.first())
+            .map(|(family, _)| SharedString::from(family.clone()));
+        self.color_emoji_families.insert(ch, family.clone());
