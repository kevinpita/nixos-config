+/// A one-cell emoji. The emoji font draws it two cells wide, so it covers
+/// the next character unless it is fitted to its cell (U+1F579).
+fn narrow_emoji(c: &vt::Cell) -> bool {
+    !c.wide && (c.text.contains('\u{FE0F}') || c.text.chars().next().is_some_and(|ch| matches!(ch as u32, 0x1F000..=0x1FAFF)))
+}
