+    #[test]
+    #[cfg(target_os = "linux")]
+    fn dead_keys_type_only_the_composed_text() {
+        // GPUI on Linux: the dead ^ of es (the US "[" key) marks "^" and
+        // arrives without text. Space then arrives with the composed "^".
+        for setup in [b"".as_slice(), b"\x1b[>1u"] {
+            let mut vt = Vt::new(20, 3);
+            vt.write(setup);
+            let mut marked = Some("^".to_owned());
+            let mut typed = Vec::new();
+            for ev in [press("[", None), press("asciicircum", Some("^"))] {
+                if !dead_key_pending(&mut marked, &ev) {
+                    typed.extend(key_bytes(&mut vt, &ev).unwrap_or_default());
+                }
+            }
+            assert_eq!(String::from_utf8_lossy(&typed), "^", "mode={setup:?}");
+            assert_eq!(marked, None, "mode={setup:?}");
+            // Without a pending accent, the key types as before.
+            assert!(!dead_key_pending(&mut marked, &press("[", None)));
+        }
+    }
