+/// A Linux dead key marks its accent before its key event, which has no
+/// text: the accent waits for the next key, so that event types nothing.
+/// The next key carries the composed text but leaves the mark: it is cleared.
+#[cfg(target_os = "linux")]
+fn dead_key_pending(marked: &mut Option<String>, ev: &KeyDownEvent) -> bool {
+    if marked.is_none() {
+        return false;
+    }
+    if ev.keystroke.key_char.is_none() {
+        return true;
+    }
+    *marked = None;
+    false
+}
