 }
+
+fn hover_actions(focus_follows_mouse: bool, focused_pane_id: &str) -> Vec<ClientShellAction> {
+    let mut config = Config::default();
+    config.ui.focus_follows_mouse = focus_follows_mouse;
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&config));
+    let mut snapshot = snapshot();
+    snapshot.focused_pane_id = Some(focused_pane_id.into());
+    state.set_snapshot(Box::new(snapshot));
+    state.set_pane_surface(surface());
+    state.compose(106, 20).expect("pane frame");
+    let pane = state.hits.panes[0].clone();
+    state
+        .handle_raw_events(vec![RawInputEvent::Mouse(MouseEvent {
+            kind: MouseEventKind::Moved,
+            column: pane.inner_rect.x + 1,
+            row: pane.inner_rect.y,
+            modifiers: KeyModifiers::empty(),
+        })])
+        .actions
+}
+
+#[test]
+fn focus_follows_mouse_focuses_hovered_pane() {
+    assert!(matches!(
+        &hover_actions(true, "pane_2")[..],
+        [ClientShellAction::Endpoint { request, .. }]
+            if matches!(&request.method,
+                crate::api::schema::Method::PaneFocus(target) if target.pane_id == "pane_1")
+    ));
+}
+
+#[test]
+fn focus_follows_mouse_skips_focused_pane_and_is_off_by_default() {
+    assert!(hover_actions(true, "pane_1").is_empty());
+    assert!(hover_actions(false, "pane_2").is_empty());
+}
