    {
      "id": 9,
      "title": "Mounted filesystem usage by disk",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "description": "Each filesystem is counted once and mapped to its backing disk, including through encryption. Usage covers mounted single-disk filesystems and includes reserved space. Multi-disk filesystems and ZFS pools are not attributed to individual disks. Collection older than three minutes is hidden.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "noValue": "No data",
          "mappings": [],
          "min": 0,
          "max": 100,
          "decimals": 1
