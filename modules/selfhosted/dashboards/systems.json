      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_disk_mounted_available_bytes{job=\"node\",instance=\"$instance\"} / (node_disk_mounted_size_bytes{job=\"node\",instance=\"$instance\"} > 0)) and on (instance) (time() - node_disk_collection_timestamp_seconds{job=\"node\",instance=\"$instance\"} < 180)",
          "legendFormat": "{{device}} - {{model}}",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ]
    },
