    {
      "id": 15,
      "title": "Disk busy time",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "description": "Time with at least one I/O request active. This is not a complete saturation measure for parallel devices.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "noValue": "No data",
          "mappings": [],
          "min": 0,
          "max": 100,
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisCenteredZero": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * rate(node_disk_io_time_seconds_total{job=\"node\",instance=\"$instance\",device!~\"loop.*|ram.*|zram.*|fd.*\"}[$__rate_interval])",
          "legendFormat": "{{device}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 16,
      "title": "Largest system folders",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 12,
        "h": 12
      },
      "description": "Top 20 main system folders by allocated bytes from du -x. Refreshed every six hours. Virtual filesystems and ZFS data are excluded. Child mounts are not included in their parent's size. Btrfs shared extents are not deduplicated. Data older than eight hours is hidden.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "No data",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sort_desc(topk(20, node_folder_allocated_bytes{job=\"node\",instance=\"$instance\",scope=\"system\"}) and on (instance) (time() - node_folder_collection_timestamp_seconds{job=\"node\",instance=\"$instance\"} < 28800))",
          "legendFormat": "{{path}}",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ]
