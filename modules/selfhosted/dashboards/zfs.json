    {
      "id": 5,
      "title": "Pool space used",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 6
      },
      "description": "Raw pool allocation. RAID-Z parity, reservations, and ZFS overhead mean this differs from filesystem space available.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "noValue": "No data",
          "mappings": [],
          "min": 0,
          "max": 100,
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * zfs_pool_allocated_bytes{job=\"zfs\",host=\"$host\",pool=~\"$pool\"} / zfs_pool_size_bytes{job=\"zfs\",host=\"$host\",pool=~\"$pool\"}",
          "legendFormat": "{{pool}}",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ]
    },
