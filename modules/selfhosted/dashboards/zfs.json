          },
          "noValue": "No data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "ONLINE",
                  "color": "green"
                },
                "1": {
                  "text": "DEGRADED",
                  "color": "yellow"
                },
                "2": {
                  "text": "FAULTED",
                  "color": "red"
                },
                "3": {
                  "text": "OFFLINE",
                  "color": "red"
                },
                "4": {
                  "text": "UNAVAIL",
                  "color": "red"
                },
                "5": {
                  "text": "REMOVED",
                  "color": "red"
                },
                "6": {
                  "text": "SUSPENDED",
                  "color": "red"
                }
              }
            }
