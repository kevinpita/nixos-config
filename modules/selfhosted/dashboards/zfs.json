        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "zfs_pool_health{job=\"zfs\",host=\"$host\",pool=~\"$pool\"}",
          "legendFormat": "{{pool}}",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ]
    },
