{
  "uid": "zfs-pools",
  "title": "ZFS pools",
  "description": "Select a device and one or more pools. Pool properties come from zfs_exporter; dataset I/O and host-wide ARC data come from node-exporter.",
  "tags": [
    "nixos",
    "selfhosted"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Device",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"zfs\"}, host)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(up{job=\"zfs\"}, host)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "options": [],
        "current": {}
      },
      {
        "name": "pool",
        "label": "Pool",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(zfs_pool_health{job=\"zfs\",host=\"$host\"}, pool)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(zfs_pool_health{job=\"zfs\",host=\"$host\"}, pool)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "options": [],
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "ZFS exporter",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "No data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"zfs\",host=\"$host\"}",
          "legendFormat": "Status",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 2,
      "title": "Pool collection",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "description": "A successful HTTP request alone does not prove that pool collection succeeded. Failed or slow collection can return cached properties.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "No data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "FAILED",
                  "color": "red"
                },
                "1": {
                  "text": "OK",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "zfs_scrape_collector_success{job=\"zfs\",host=\"$host\",collector=\"pool\"}",
          "legendFormat": "Collection",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 3,
