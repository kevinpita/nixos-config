{
  "uid": "comin",
  "title": "Comin deployments",
  "description": "Pull-based NixOS deployments across the server fleet. Metrics describe local Comin events, not whether a host matches the current GitHub branch.",
  "tags": [
    "nixos",
    "comin"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Device",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"comin\"}, host)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(up{job=\"comin\"}, host)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Exporter reachability",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "description": "Reachability through Tailscale. Missing samples are not shown as healthy.",
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "UP",
                  "color": "green"
                },
                "1": {
                  "text": "DOWN",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - up{job=\"comin\",host=~\"$host\"}",
          "legendFormat": "{{host}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 10,
      "title": "Last successful deployment",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "description": "Local date and time recorded by the Comin post-deployment hook after a successful deployment. Persists across restarts. Available after the first successful deployment with the hook enabled. Failed attempts leave the previous time unchanged. This is not a Git commit time or a Prometheus scrape time.",
      "fieldConfig": {
        "defaults": {
          "noValue": "No recorded deployment"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Deployed"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(comin_last_successful_deployment_timestamp_seconds{job=\"node\",host=~\"$host\"} > 0) * 1000 and on(instance) (up{job=\"node\",host=~\"$host\"} == 1)",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "renameByName": {
              "host": "Host",
              "Value": "Deployed"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "sortBy": [
          {
            "displayName": "Host",
            "desc": false
          }
        ]
      }
    },
    {
      "id": 3,
      "title": "Reboot required",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "description": "Comin reports that a reboot is required. This dashboard does not reboot hosts.",
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "No",
                  "color": "green"
                },
                "1": {
                  "text": "Yes",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "comin_need_to_reboot{job=\"comin\",host=~\"$host\"} and on(instance) (up{job=\"comin\",host=~\"$host\"} == 1)",
          "legendFormat": "{{host}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 4,
      "title": "Last fetch",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 4
      },
      "description": "Last reported stage result, not proof that the latest GitHub commit is deployed. Gauges can reset when Comin restarts.",
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "No failure reported",
                  "color": "green"
                },
                "1": {
                  "text": "Failed",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(host, instance) (comin_last_fetch_failed{job=\"comin\",host=~\"$host\"}) and on(instance) (up{job=\"comin\",host=~\"$host\"} == 1)",
          "legendFormat": "{{host}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 7,
      "title": "Last activation",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 4
      },
      "description": "Last reported activation result. Missing or unreachable exporters are not shown as successful.",
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "No failure reported",
                  "color": "green"
                },
                "1": {
                  "text": "Failed",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "comin_last_deployment_failed{job=\"comin\",host=~\"$host\"} and on(instance) (up{job=\"comin\",host=~\"$host\"} == 1)",
          "legendFormat": "{{host}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 8,
      "title": "Latest deployment reported by Comin",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Commit and status of the last reported deployment, which may have failed. This is not a comparison against GitHub HEAD. Data may be absent until a deployment is reported after restart.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "comin_deployment_info{job=\"comin\",host=~\"$host\"} and on(instance) (up{job=\"comin\",host=~\"$host\"} == 1)",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "Value": true
            },
            "renameByName": {
              "host": "Host",
              "commit_id": "Commit",
              "status": "Status"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 9,
      "title": "Git fetches per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Fetch attempts by host, remote, and result. These are repository polls, not deployments.",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(comin_fetch_count{job=\"comin\",host=~\"$host\"}[$__rate_interval])",
          "legendFormat": "{{host}} / {{remote_name}} / {{status}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
