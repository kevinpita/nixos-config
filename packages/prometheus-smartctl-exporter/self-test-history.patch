+func (smart *SMARTctl) mineSelfTestAge() {
+	hours := smart.json.Get("power_on_time.hours")
+	if !hours.Exists() || hours.Float() < 0 {
+		return
+	}
+	nvme := smart.json.Get("nvme_self_test_log").Exists()
+	table := smart.json.Get("nvme_self_test_log.table")
+	if !nvme {
+		// ATA log timestamps wrap at 65536 hours. Do not guess an epoch.
+		if hours.Float() >= 65536 {
+			return
+		}
+		table = smart.json.Get("ata_smart_self_test_log.extended.table")
+		if len(table.Array()) == 0 {
+			table = smart.json.Get("ata_smart_self_test_log.standard.table")
+		}
+	}
+	// smartctl returns the newest entries first. Do not replace a recent
+	// failure or abort with an older successful result.
+	for _, entry := range table.Array() {
+		status := entry.Get("status.value")
+		ended := entry.Get("lifetime_hours")
+		if nvme {
+			status = entry.Get("self_test_result.value")
+			ended = entry.Get("power_on_hours")
+		}
+		if !status.Exists() {
+			continue
+		}
+		code := status.Int()
+		if !nvme {
+			code >>= 4
+		}
+		if code == 15 { // ATA still running, or unused NVMe entry.
+			continue
+		}
+		if !ended.Exists() || ended.Float() < 0 || ended.Float() > hours.Float() {
+			return
+		}
+		result := "Unknown"
+		if code == 0 {
+			result = "Passed"
+		} else if (!nvme && code >= 3 && code <= 8) || (nvme && code >= 5 && code <= 7) {
+			result = "Failed"
+		} else if (!nvme && (code == 1 || code == 2)) || (nvme && ((code >= 1 && code <= 4) || code == 8 || code == 9)) {
+			result = "Aborted"
+		}
+		smart.ch <- prometheus.MustNewConstMetric(
+			metricDeviceSelfTestAge,
+			prometheus.GaugeValue,
+			(hours.Float()-ended.Float())*3600,
+			smart.device.device,
+			result,
+		)
+		return
+	}
+}
