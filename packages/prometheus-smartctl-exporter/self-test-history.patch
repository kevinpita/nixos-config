+// Query the log separately: unsupported self-tests must not discard valid health.
+func withSelfTestLog(logger *slog.Logger, device Device, health gjson.Result) gjson.Result {
+	out, _ := exec.Command(*smartctlPath, "--json", "--log=selftest", "--nocheck="+*smartctlPowerModeCheck, "--device="+device.Type, device.Name).Output()
+	log := parseJSON(string(out))
+	status := log.Get("smartctl.exit_status")
+	if !status.Exists() || !resultCodeIsOk(logger, device, status.Int()) || !jsonIsOk(logger, log) {
+		return health
+	}
+	var merged map[string]stdjson.RawMessage
+	if err := stdjson.Unmarshal([]byte(health.Raw), &merged); err != nil || merged == nil {
+		return health
+	}
+	for _, key := range []string{"ata_smart_self_test_log", "nvme_self_test_log"} {
+		if value := log.Get(key); value.Exists() {
+			merged[key] = stdjson.RawMessage(value.Raw)
+		}
+	}
+	out, err := stdjson.Marshal(merged)
+	if err != nil {
+		return health
+	}
+	return parseJSON(string(out))
 }
 
