+package main
+
+import (
+	"log/slog"
+	"testing"
+
+	"github.com/prometheus/client_golang/prometheus"
+	dto "github.com/prometheus/client_model/go"
+	"github.com/tidwall/gjson"
+)
+
+// A fresh scrape must not make cached SMART health look newly read.
+func TestHealthReadTime(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		json string
+		want float64
+	}{
+		{"cached passed", `{"device":{"name":"/dev/nvme0","type":"nvme"},"smart_status":{"passed":true},"local_time":{"time_t":1600000000}}`, 1600000000},
+		{"cached failed", `{"smart_status":{"passed":false},"local_time":{"time_t":1600000001}}`, 1600000001},
+		{"missing timestamp", `{"smart_status":{"passed":true}}`, 0},
+		{"missing health", `{"local_time":{"time_t":1600000000}}`, 0},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			for range 2 {
+				ch := make(chan prometheus.Metric, 8)
+				smart := NewSMARTctl(slog.Default(), gjson.Parse(tc.json), ch)
+				smart.mineSmartStatus()
+				close(ch)
+				found := false
+				for metric := range ch {
+					if metric.Desc().String() != prometheus.NewDesc("smartctl_device_smart_status_read_time_seconds", "Unix time of the SMART health read, retained with cached results.", []string{"device"}, nil).String() {
+						continue
+					}
+					found = true
+					var value dto.Metric
+					if err := metric.Write(&value); err != nil {
+						t.Fatal(err)
+					}
+					if value.GetGauge().GetValue() != tc.want {
+						t.Fatalf("got %v, want %v", value.GetGauge().GetValue(), tc.want)
+					}
+				}
+				if found != (tc.want != 0) {
+					t.Fatalf("timestamp present = %v, want %v", found, tc.want != 0)
+				}
+			}
+		})
+	}
+}
