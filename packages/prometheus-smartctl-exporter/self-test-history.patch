+package main
+
+import (
+	"log/slog"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/prometheus/client_golang/prometheus"
+	dto "github.com/prometheus/client_model/go"
+	"github.com/tidwall/gjson"
+)
+
+func TestSelfTestLogRead(t *testing.T) {
+	original := *smartctlPath
+	t.Cleanup(func() { *smartctlPath = original })
+	for _, tc := range []struct {
+		name, output, exit string
+		wantLog            bool
+	}{
+		{"available", `{"smartctl":{"exit_status":0},"ata_smart_self_test_log":{"standard":{"table":[{"status":{"value":0},"lifetime_hours":75}]}}}`, "0", true},
+		{"failed test is still evidence", `{"smartctl":{"exit_status":128},"ata_smart_self_test_log":{"standard":{"table":[{"status":{"value":112},"lifetime_hours":75}]}}}`, "128", true},
+		{"unsupported keeps health", `{"smartctl":{"exit_status":2,"messages":[{"severity":"error","string":"unsupported"}]}}`, "2", false},
+		{"invalid response keeps health", `not json`, "1", false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "smartctl")
+			script := "#!/bin/sh\ncase \" $* \" in *' --log=selftest '*) ;; *) exit 1 ;; esac\nprintf '%s' '" + tc.output + "'\nexit " + tc.exit + "\n"
+			if err := os.WriteFile(path, []byte(script), 0700); err != nil {
+				t.Fatal(err)
+			}
+			*smartctlPath = path
+			health := gjson.Parse(`{"smart_status":{"passed":true},"local_time":{"time_t":1600000000},"power_on_time":{"hours":100}}`)
+			got := withSelfTestLog(slog.Default(), Device{Name: "/dev/sda", Type: "sat"}, health)
+			if !got.Get("smart_status.passed").Bool() || got.Get("local_time.time_t").Int() != 1600000000 {
+				t.Fatal("health or original timestamp lost")
+			}
+			if got.Get("ata_smart_self_test_log").Exists() != tc.wantLog {
+				t.Fatalf("log presence = %v", !tc.wantLog)
+			}
+		})
+	}
+}
+
+// Only a recorded self-test can supply test age. Overall health and scrape
+// times must not substitute for a test, and old tests must remain old.
+func TestSelfTestHistoryAge(t *testing.T) {
+	for _, tc := range []struct {
+		name, data, result string
+		age                float64
+		present            bool
+	}{
+		{"ATA passed", `{"power_on_time":{"hours":100},"ata_smart_self_test_log":{"standard":{"table":[{"status":{"value":0},"lifetime_hours":75}]}}}`, "Passed", 25 * 3600, true},
+		{"ATA latest failed", `{"power_on_time":{"hours":100},"ata_smart_self_test_log":{"standard":{"table":[{"status":{"value":112},"lifetime_hours":90},{"status":{"value":0},"lifetime_hours":75}]}}}`, "Failed", 10 * 3600, true},
+		{"ATA aborted", `{"power_on_time":{"hours":100},"ata_smart_self_test_log":{"standard":{"table":[{"status":{"value":16},"lifetime_hours":90}]}}}`, "Aborted", 10 * 3600, true},
+		{"ATA running keeps prior age", `{"power_on_time":{"hours":100},"ata_smart_self_test_log":{"standard":{"table":[{"status":{"value":249},"lifetime_hours":100},{"status":{"value":0},"lifetime_hours":75}]}}}`, "Passed", 25 * 3600, true},
+		{"ATA extended preferred", `{"power_on_time":{"hours":100},"ata_smart_self_test_log":{"extended":{"table":[{"status":{"value":0},"lifetime_hours":99}]},"standard":{"table":[{"status":{"value":0},"lifetime_hours":75}]}}}`, "Passed", 3600, true},
+		{"NVMe passed five years ago", `{"power_on_time":{"hours":45000},"nvme_self_test_log":{"table":[{"self_test_result":{"value":0},"power_on_hours":1200}]}}`, "Passed", 43800 * 3600, true},
+		{"NVMe failed", `{"power_on_time":{"hours":100},"nvme_self_test_log":{"table":[{"self_test_result":{"value":7},"power_on_hours":98}]}}`, "Failed", 7200, true},
+		{"NVMe aborted", `{"power_on_time":{"hours":100},"nvme_self_test_log":{"table":[{"self_test_result":{"value":2},"power_on_hours":98}]}}`, "Aborted", 7200, true},
+		{"zero lifetime valid", `{"power_on_time":{"hours":1},"nvme_self_test_log":{"table":[{"self_test_result":{"value":0},"power_on_hours":0}]}}`, "Passed", 3600, true},
+		{"health is not a test", `{"power_on_time":{"hours":100},"smart_status":{"passed":true}}`, "", 0, false},
+		{"empty log", `{"power_on_time":{"hours":100},"nvme_self_test_log":{"table":[]}}`, "", 0, false},
+		{"missing hours", `{"nvme_self_test_log":{"table":[{"self_test_result":{"value":0},"power_on_hours":98}]}}`, "", 0, false},
+		{"missing entry time", `{"power_on_time":{"hours":100},"nvme_self_test_log":{"table":[{"self_test_result":{"value":0}}]}}`, "", 0, false},
+		{"future entry", `{"power_on_time":{"hours":10},"nvme_self_test_log":{"table":[{"self_test_result":{"value":0},"power_on_hours":98}]}}`, "", 0, false},
+		{"ATA wrap ambiguous", `{"power_on_time":{"hours":65536},"ata_smart_self_test_log":{"standard":{"table":[{"status":{"value":0},"lifetime_hours":0}]}}}`, "", 0, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ch := make(chan prometheus.Metric, 128)
+			smart := NewSMARTctl(slog.Default(), gjson.Parse(tc.data), ch)
+			smart.Collect()
+			close(ch)
+			found := false
+			for metric := range ch {
+				if metric.Desc().String() != prometheus.NewDesc("smartctl_device_self_test_age_seconds", "Powered-on seconds since the latest recorded self-test ended, excluding tests still running.", []string{"device", "result"}, nil).String() {
+					continue
+				}
+				found = true
+				var value dto.Metric
+				if err := metric.Write(&value); err != nil {
+					t.Fatal(err)
+				}
+				if value.GetGauge().GetValue() != tc.age {
+					t.Fatalf("age = %v, want %v", value.GetGauge().GetValue(), tc.age)
+				}
+				for _, label := range value.GetLabel() {
+					if label.GetName() == "result" && label.GetValue() != tc.result {
+						t.Fatalf("result = %s, want %s", label.GetValue(), tc.result)
+					}
+				}
+			}
+			if found != tc.present {
+				t.Fatalf("present = %v, want %v", found, tc.present)
+			}
+		})
+	}
+}
