diff --git a/packages/tui/test/extension-links.test.ts b/packages/tui/test/extension-links.test.ts
index dfaaa3a..7dea9a4 100644
--- a/packages/tui/test/extension-links.test.ts
+++ b/packages/tui/test/extension-links.test.ts
@@ -439,4 +439,25 @@ describe("extension link hints", () => {
 			composer.stop();
 		}
 	});
+
+	it("keeps a markdown preview one target that copies the source, inner links and fences included", () => {
+		const source = "# Steps\n\nSee [docs](https://example.com).\n\n```sh\necho hi\n```";
+		const hyperlinks = TERMINAL.hyperlinks;
+		let rows: readonly string[];
+		setTerminalHyperlinks(true);
+		try {
+			setExtensionLinks([CODE_COPY_SCHEME]);
+			rows = new Markdown(`\`\`\`\`md\n${source}\n\`\`\`\``, 1, 0, getMarkdownTheme(), undefined, 0).render(30);
+		} finally {
+			setTerminalHyperlinks(hyperlinks);
+		}
+
+		const labels = rows.map(row => extensionLinkLabels(row));
+		const body = labels.slice(1, -1);
+		expect(rows.map(plain)).toContain("Steps".padEnd(30));
+		for (const row of body) expect(row.map(({ start, end }) => [start, end])).toEqual([[0, 30]]);
+		const urls = new Set([labels[0]!, ...body].flat().map(label => label.url));
+		expect(urls.size).toBe(1);
+		expect(codeCopySource([...urls][0]!)).toBe(source);
+	});
 });
