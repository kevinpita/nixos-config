diff --git a/packages/tui/src/render/code-copy.ts b/packages/tui/src/render/code-copy.ts
new file mode 100644
index 0000000..c835812
--- /dev/null
+++ b/packages/tui/src/render/code-copy.ts
@@ -0,0 +1,29 @@
+/**
+ * Click-to-copy targets on fenced code blocks. The renderer draws each closed block's rows as an
+ * extension link to `omp-copy:<id>`; the id names the block source kept here, so activating the link
+ * copies the source exactly as written, without the rows' wrapping or padding. A model can write an
+ * `omp-copy:` link itself, so an activation only ever copies a source this process rendered.
+ */
+import { LRUCache } from "@oh-my-pi/pi-utils/lru";
+
+export const CODE_COPY_SCHEME = "omp-copy";
+
+const PREFIX = `${CODE_COPY_SCHEME}:`;
+const sources = new LRUCache<string, string>({ max: 2048 });
+
+/** The link URL for a block with this source; remembers the source for {@link codeCopySource}. */
+export function codeCopyHref(source: string): string {
+	const id = Bun.hash(source).toString(36);
+	sources.set(id, source);
+	return PREFIX + id;
+}
+
+/** Whether `url` is a code-copy link. */
+export function isCodeCopyUrl(url: string): boolean {
+	return url.startsWith(PREFIX);
+}
+
+/** The block source behind a code-copy link, or `undefined` when this process did not render it. */
+export function codeCopySource(url: string): string | undefined {
+	return isCodeCopyUrl(url) ? sources.get(url.slice(PREFIX.length)) : undefined;
+}
