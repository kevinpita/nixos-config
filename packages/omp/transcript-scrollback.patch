diff --git a/packages/tui/src/overlays/transcript-scrollback.ts b/packages/tui/src/overlays/transcript-scrollback.ts
new file mode 100644
index 0000000..3246886
--- /dev/null
+++ b/packages/tui/src/overlays/transcript-scrollback.ts
@@ -0,0 +1,116 @@
+/**
+ * Wheel scrollback for the main transcript (`tui.mouse`).
+ *
+ * With mouse tracking on, the terminal hands wheel reports to omp instead of scrolling its own
+ * scrollback, and a click on a row the terminal has scrolled back reports only its screen row, so
+ * a click there cannot be traced to the row drawn under it. This fullscreen page draws the
+ * transcript itself, scrolled by the wheel and the arrow/page keys: every visible row is known,
+ * so a click reaches the extension link drawn under it, a code block's copy target included. It
+ * shows the transcript as it was when it opened; Esc, `q`, or scrolling past the bottom return
+ * to the live view.
+ */
+import { matchesKey } from "../keys";
+import { routeSgrMouseInput } from "../mouse";
+import { extensionLinkLabels } from "../render/extension-links";
+import { theme } from "../theme/theme";
+import type { Component } from "../tui";
+import { truncateToWidth } from "../utils";
+
+const WHEEL_ROWS = 3;
+
+export interface TranscriptScrollbackOptions {
+	/** The whole transcript at `width`, oldest row first. */
+	readonly rows: (width: number) => readonly string[];
+	/** Screen height; the page fills it, its last row a footer. */
+	readonly height: () => number;
+	/** Activate the extension link `url` under a click. Returns false when nothing handles it. */
+	readonly activateLink: (url: string) => boolean;
+	readonly onClose: () => void;
+}
+
+export class TranscriptScrollback implements Component {
+	#rows: readonly string[] = [];
+	#width = 0;
+	/** Rows hidden below the page, so a resize keeps the bottom in place. Opens one wheel notch up. */
+	#fromBottom = WHEEL_ROWS;
+	#notice: string | undefined;
+
+	constructor(private readonly options: TranscriptScrollbackOptions) {}
+
+	/** Whether the transcript at `width` is taller than the page, so there is something to scroll back to. */
+	canScroll(width: number): boolean {
+		this.#load(width);
+		return this.#rows.length > this.#body();
+	}
+
+	/** Show `text` in the footer until the next scroll. */
+	setNotice(text: string): void {
+		this.#notice = text;
+	}
+
+	render(width: number): readonly string[] {
+		if (width !== this.#width) this.#load(width);
+		const body = this.#body();
+		const top = this.#top();
+		const lines = this.#rows.slice(top, top + body);
+		while (lines.length < body) lines.push("");
+		const percent = Math.round((top / Math.max(1, this.#rows.length - body)) * 100);
+		const footer =
+			this.#notice ?? `Scrollback ${percent}%  wheel/Up/Down scroll  click a code block to copy  Esc returns`;
+		lines.push(theme.fg("dim", truncateToWidth(footer, width)));
+		return lines;
+	}
+
+	handleInput(data: string): void {
+		const mouse = routeSgrMouseInput(data, event => {
+			if (event.wheel !== null) this.#scroll(event.wheel * WHEEL_ROWS);
+			else if (event.leftClick) this.#click(event.row, event.col);
+			return true;
+		});
+		if (mouse) return;
+		const page = Math.max(1, this.#body() - 1);
+		if (matchesKey(data, "escape") || data === "q") this.options.onClose();
+		else if (matchesKey(data, "up")) this.#scroll(-1);
+		else if (matchesKey(data, "down")) this.#scroll(1);
+		else if (matchesKey(data, "pageUp")) this.#scroll(-page);
+		else if (matchesKey(data, "pageDown")) this.#scroll(page);
+		else if (matchesKey(data, "home")) this.#scroll(-this.#rows.length);
+		else if (matchesKey(data, "end")) this.options.onClose();
+	}
+
+	invalidate(): void {
+		this.#width = 0;
+	}
+
+	#load(width: number): void {
+		this.#width = width;
+		this.#rows = this.options.rows(width);
+	}
+
+	#body(): number {
+		return Math.max(1, this.options.height() - 1);
+	}
+
+	#top(): number {
+		return Math.max(0, this.#rows.length - this.#body() - this.#fromBottom);
+	}
+
+	/** Scroll `delta` rows down (negative: up); past the bottom returns to the live view. */
+	#scroll(delta: number): void {
+		this.#notice = undefined;
+		const next = this.#fromBottom - delta;
+		if (next < 0) {
+			this.options.onClose();
+			return;
+		}
+		this.#fromBottom = Math.min(next, Math.max(0, this.#rows.length - this.#body()));
+	}
+
+	#click(row: number, col: number): void {
+		if (row < 0 || row >= this.#body()) return;
+		const line = this.#rows[this.#top() + row];
+		if (line === undefined) return;
+		const label = extensionLinkLabels(line).find(label => col >= label.start && col < label.end);
+		if (label) this.options.activateLink(label.url);
+	}
+}
